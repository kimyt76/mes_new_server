<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="TransactionStatement_A4_2UP"
        pageWidth="595"
        pageHeight="842"
        orientation="Portrait"
        columnWidth="555"
        leftMargin="20"
        rightMargin="20"
        topMargin="0"
        bottomMargin="0"
        whenNoDataType="AllSectionsNoDetail">

    <!-- ========================================================= -->
    <!-- PARAMETER -->
    <!-- ========================================================= -->
    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="bizNo" class="java.lang.String"/>
    <parameter name="ceoName" class="java.lang.String"/>
    <parameter name="bizType" class="java.lang.String"/>
    <parameter name="bizItem" class="java.lang.String"/>
    <parameter name="address" class="java.lang.String"/>
    <parameter name="tel" class="java.lang.String"/>
    <parameter name="poNo" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="sealImagePath" class="java.lang.String"/>

    <parameter name="totalQty" class="java.math.BigDecimal"/>
    <parameter name="totalPallet" class="java.math.BigDecimal"/>
    <parameter name="totalLoadQty" class="java.lang.Integer"/>
    <parameter name="deliveryAddress" class="java.lang.String"/>
    <parameter name="deliveryManager" class="java.lang.String"/>
    <parameter name="deliveryContact" class="java.lang.String"/>
    <parameter name="etc" class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- FIELD -->
    <!-- pageNo : 명세서 페이지 순번(1,2,3...) -->
    <!-- copyNo : 같은 페이지 내 사본 순번(1,2) -->
    <!-- 한 copy 당 반드시 10행이 되도록 서버에서 빈 행 padding -->
    <!-- ========================================================= -->
    <field name="pageNo" class="java.lang.Integer"/>
    <field name="copyNo" class="java.lang.Integer"/>
    <field name="shipmentReqDate" class="java.lang.String"/>
    <field name="itemName" class="java.lang.String"/>
    <field name="qty" class="java.math.BigDecimal"/>
    <field name="pallet" class="java.math.BigDecimal"/>
    <field name="lotNo" class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- COPY GROUP
         A4 842pt / 2 = 421pt
         HEADER 136 + DETAIL(16*10=160) + FOOTER 125 = 421
         따라서 1페이지에 정확히 2개가 배치됨.
    -->
    <!-- ========================================================= -->
    <group name="CopyGroup">
        <groupExpression><![CDATA[
            String.valueOf($F{pageNo}) + "-" + String.valueOf($F{copyNo})
        ]]></groupExpression>

        <groupHeader>
            <band height="136" splitType="Prevent">

                <!-- 내부 상단 여백 10pt -->

                <!-- 거래명세서 -->
                <staticText>
                    <reportElement x="0" y="15" width="235" height="35"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="22" isBold="true"/>
                    </textElement>
                    <text><![CDATA[거래명세서]]></text>
                </staticText>

                <!-- 공급받는자 -->
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="57" width="235" height="51"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="11" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
                </textField>

                <!-- 공급받는자 테두리 -->
                <line><reportElement x="0" y="57" width="235" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="0" y="107" width="235" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="0" y="57" width="1" height="51"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="234" y="57" width="1" height="51"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

                <!-- 공급자 세로 타이틀 -->
                <staticText>
                    <reportElement x="245" y="13" width="17" height="95"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[공
급
자]]></text>
                </staticText>

                <!-- 일련번호 -->
                <staticText>
                    <reportElement x="262" y="13" width="65" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement>
                    <text><![CDATA[일련번호]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="327" y="13" width="78" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement>
                    <textFieldExpression><![CDATA[$P{poNo}]]></textFieldExpression>
                </textField>

                <!-- TEL -->
                <staticText>
                    <reportElement x="405" y="13" width="35" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement>
                    <text><![CDATA[TEL]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="440" y="13" width="115" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement>
                    <textFieldExpression><![CDATA[$P{tel}]]></textFieldExpression>
                </textField>

                <!-- 사업자등록번호 -->
                <staticText>
                    <reportElement x="262" y="33" width="65" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="6" isBold="true"/></textElement>
                    <text><![CDATA[사업자등록번호]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="327" y="33" width="113" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement>
                    <textFieldExpression><![CDATA[$P{bizNo}]]></textFieldExpression>
                </textField>

                <!-- 성명 -->
                <staticText>
                    <reportElement x="440" y="33" width="35" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement>
                    <text><![CDATA[성명]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="475" y="33" width="80" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement>
                    <textFieldExpression><![CDATA[$P{ceoName}]]></textFieldExpression>
                </textField>

                <!-- 상호 -->
                <staticText>
                    <reportElement x="262" y="53" width="65" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement>
                    <text><![CDATA[상호]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="327" y="53" width="228" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement>
                    <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
                </textField>

                <!-- 주소 -->
                <staticText>
                    <reportElement x="262" y="73" width="65" height="35"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement>
                    <text><![CDATA[주소]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="327" y="73" width="228" height="35"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="6"/></textElement>
                    <textFieldExpression><![CDATA[$P{address}]]></textFieldExpression>
                </textField>

                <!-- 공급자 TABLE 세로선 -->
                <line><reportElement x="245" y="13" width="1" height="95"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="262" y="13" width="1" height="95"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="327" y="13" width="1" height="95"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="405" y="13" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="440" y="13" width="1" height="40"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="475" y="33" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="554" y="13" width="1" height="95"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

                <!-- 공급자 TABLE 가로선 -->
                <line><reportElement x="245" y="13" width="310" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="262" y="33" width="293" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="262" y="53" width="293" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="262" y="73" width="293" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="245" y="107" width="310" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

                <!-- 직인 -->
                <image scaleImage="RetainShape" onErrorType="Blank">
                    <reportElement x="478" y="43" width="55" height="55"/>
                    <imageExpression class="java.lang.String"><![CDATA[$P{sealImagePath}]]></imageExpression>
                </image>

                <!-- LIST HEADER : y 118 ~ 136 -->
                <staticText><reportElement x="0" y="118" width="55" height="18" mode="Opaque" backcolor="#EEEEEE"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[월/일]]></text></staticText>
                <staticText><reportElement x="55" y="118" width="260" height="18" mode="Opaque" backcolor="#EEEEEE"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[품명 및 규격]]></text></staticText>
                <staticText><reportElement x="315" y="118" width="70" height="18" mode="Opaque" backcolor="#EEEEEE"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[수량]]></text></staticText>
                <staticText><reportElement x="385" y="118" width="70" height="18" mode="Opaque" backcolor="#EEEEEE"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[파렛트]]></text></staticText>
                <staticText><reportElement x="455" y="118" width="100" height="18" mode="Opaque" backcolor="#EEEEEE"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[LOT]]></text></staticText>

                <!-- LIST HEADER BORDER -->
                <line><reportElement x="0" y="118" width="555" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="0" y="135" width="555" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="0" y="118" width="1" height="18"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="55" y="118" width="1" height="18"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="315" y="118" width="1" height="18"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="385" y="118" width="1" height="18"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="455" y="118" width="1" height="18"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="554" y="118" width="1" height="18"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

            </band>
        </groupHeader>

        <groupFooter>
            <band height="125" splitType="Prevent">

                <!-- ===================================================== -->
                <!-- 하단 합계 1행 : y=0 ~ 20 -->
                <!-- 총수량 | 총파렛트수량 | 총로드수량 | 인수 -->
                <!-- ===================================================== -->
                <staticText><reportElement x="0" y="0" width="55" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[총수량]]></text></staticText>
                <textField pattern="#,##0.###" isBlankWhenNull="true"><reportElement x="55" y="0" width="70" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement><textFieldExpression><![CDATA[$P{totalQty}]]></textFieldExpression></textField>

                <staticText><reportElement x="125" y="0" width="80" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[총파렛트수량]]></text></staticText>
                <textField pattern="#,##0.###" isBlankWhenNull="true"><reportElement x="205" y="0" width="65" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement><textFieldExpression><![CDATA[$P{totalPallet}]]></textFieldExpression></textField>

                <staticText><reportElement x="270" y="0" width="80" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7" isBold="true"/></textElement><text><![CDATA[LOT수량]]></text></staticText>
                <textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="350" y="0" width="65" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement><textFieldExpression><![CDATA[$P{totalLoadQty}]]></textFieldExpression></textField>

                <staticText>
                    <reportElement
                            x="415"
                            y="0"
                            width="45"
                            height="20"/>

                    <textElement
                            textAlignment="Center"
                            verticalAlignment="Middle">

                        <font
                                fontName="맑은 고딕"
                                size="7"
                                isBold="true"/>

                    </textElement>

                    <text><![CDATA[인수]]></text>
                </staticText>
                <!-- 인수자 이름 기입 안내 -->
                <staticText>
                    <reportElement
                            x="460"
                            y="0"
                            width="94"
                            height="20"
                            forecolor="#BDBDBD"/>

                    <textElement
                            textAlignment="Center"
                            verticalAlignment="Middle">

                        <font
                                fontName="맑은 고딕"
                                size="6"
                                isBold="false"/>

                    </textElement>

                    <text><![CDATA[정자로 기입 바랍니다]]></text>

                </staticText>

                <!-- 1행 세로선/가로선 -->
                <line><reportElement x="0" y="20" width="555" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="0" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="55" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="125" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="205" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="270" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="350" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="415" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="460" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="554" y="0" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

                <!-- ===================================================== -->
                <!-- 하단 정보 2행 : y=20 ~ 40 -->
                <!-- 납품주소 | 납품 담당자 | 연락처 -->
                <!--
                     0   ~ 70  : 납품주소
                     70  ~ 355 : 납품주소 값
                     355 ~ 405 : 납품 담당자
                     405 ~ 445 : 담당자명
                     445 ~ 480 : 연락처
                     480 ~ 555 : 연락처 값
                -->
                <!-- ===================================================== -->

                <!-- 납품주소 -->
                <staticText>
                    <reportElement x="0" y="20" width="70" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[납품주소]]></text>
                </staticText>

                <!-- 납품주소 값 -->
                <textField isBlankWhenNull="true">
                    <reportElement x="74" y="20" width="285" height="20"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="7"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{deliveryAddress}]]></textFieldExpression>
                </textField>

                <!-- 납품 담당자 -->
                <staticText>
                    <reportElement x="355" y="20" width="50" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="6" isBold="true"/>
                    </textElement>
                    <text><![CDATA[납품 담당자]]></text>
                </staticText>

                <!-- 담당자명 -->
                <textField isBlankWhenNull="true">
                    <reportElement x="405" y="20" width="40" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="7"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{deliveryManager}]]></textFieldExpression>
                </textField>

                <!-- 연락처 -->
                <staticText>
                    <reportElement x="445" y="20" width="35" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="6" isBold="true"/>
                    </textElement>
                    <text><![CDATA[연락처]]></text>
                </staticText>

                <!-- 연락처 값 -->
                <textField isBlankWhenNull="true">
                    <reportElement x="480" y="20" width="75" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="7"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{deliveryContact}]]></textFieldExpression>
                </textField>

                <!-- 2행 하단선 -->
                <line>
                    <reportElement x="0" y="40" width="555" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>

                <!-- 2행 세로선 -->
                <line><reportElement x="0" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="70" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="355" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="405" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="445" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="480" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
                <line><reportElement x="554" y="20" width="1" height="20"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

                <!-- ===================================================== -->
                <!-- 특이사항 : y=40 ~ 84 -->
                <!-- ===================================================== -->
                <staticText>
                    <reportElement x="0" y="40" width="70" height="44"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="맑은 고딕" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[특이사항]]></text>
                </staticText>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <!-- 왼쪽 4pt 여백 -->
                    <reportElement x="74" y="40" width="481" height="44"/>
                    <textElement textAlignment="Left" verticalAlignment="Top">
                        <font fontName="맑은 고딕" size="7"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{etc}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="84" width="555" height="1"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <!-- 왼쪽 -->
                <line>
                    <reportElement x="0" y="40" width="1" height="44"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <!-- 특이사항 헤더 / 내용 구분선 -->
                <line>
                    <reportElement x="70" y="40" width="1" height="44"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <!-- 오른쪽 -->
                <line>
                    <reportElement x="554" y="40" width="1" height="44"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <!-- ===================================================== -->
                <!-- 여백 및 절취선
                     첫 번째 copy의 끝 = A4 정확한 중앙 421pt
                     footer 시작점은 136 + 160 = 296
                     footer y=124의 1pt 선이 420~421에 위치
                -->
                <!-- ===================================================== -->
                <line>
                    <reportElement x="0" y="124" width="555" height="1">
                        <printWhenExpression><![CDATA[
                            $F{copyNo} != null && $F{copyNo}.intValue() == 1
                        ]]></printWhenExpression>
                    </reportElement>
                    <graphicElement><pen lineWidth="0.5" lineStyle="Dashed"/></graphicElement>
                </line>

                <staticText>
                    <reportElement x="247" y="113" width="60" height="11" mode="Opaque" backcolor="#FFFFFF">
                        <printWhenExpression><![CDATA[
                            $F{copyNo} != null && $F{copyNo}.intValue() == 1
                        ]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="맑은 고딕" size="7"/></textElement>
                    <text><![CDATA[절 취 선]]></text>
                </staticText>

            </band>
        </groupFooter>
    </group>

