                                   width="677"
                                   height="18"/>

                    <textElement textAlignment="Center"
                                 verticalAlignment="Middle">

                        <font fontName="맑은 고딕"
                              size="7"/>
                    </textElement>

                    <textFieldExpression><![CDATA[
                        $P{etc}
                    ]]></textFieldExpression>

                </textField>


                <!-- 특이사항 선 -->

                <line>
                    <reportElement x="0" y="72"
                                   width="1" height="18"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <line>
                    <reportElement x="125" y="72"
                                   width="1" height="18"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <line>
                    <reportElement x="801" y="72"
                                   width="1" height="18"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>

                <line>
                    <reportElement x="0"
                                   y="89"
                                   width="802"
                                   height="1"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </line>


                <!-- ========================================= -->
                <!-- 첫 번째 사본 아래 절취선 -->
                <!-- ========================================= -->

                <line>
                    <reportElement x="0"
                                   y="108"
                                   width="802"
                                   height="1">

                        <printWhenExpression><![CDATA[
                            $F{copyNo} == 1
                        ]]></printWhenExpression>

                    </reportElement>

                    <graphicElement>
                        <pen lineWidth="0.5"
                             lineStyle="Dashed"/>
                    </graphicElement>
                </line>


                <staticText>
                    <reportElement x="361"
                                   y="99"
                                   width="80"
                                   height="17">

                        <printWhenExpression><![CDATA[
                            $F{copyNo} == 1
                        ]]></printWhenExpression>

                    </reportElement>

                    <textElement textAlignment="Center"
                                 verticalAlignment="Middle">

                        <font fontName="맑은 고딕"
                              size="7"/>
                    </textElement>

                    <text><![CDATA[절 취 선]]></text>
                </staticText>


            </band>

        </groupFooter>

    </group>


    <!-- ===================================================== -->
    <!-- DETAIL -->
    <!-- ===================================================== -->

    <detail>

        <band height="18">


            <!-- 월/일 -->
            <textField isBlankWhenNull="true">

                <reportElement x="0"
                               y="0"
                               width="80"
                               height="18"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font fontName="맑은 고딕"
                          size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{shipmentReqDate}
                ]]></textFieldExpression>

            </textField>


            <!-- 품명 -->
            <textField isBlankWhenNull="true">

                <reportElement x="80"
                               y="0"
                               width="385"
                               height="18"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font fontName="맑은 고딕"
                          size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{itemName}
                ]]></textFieldExpression>

            </textField>


            <!-- 수량 -->
            <textField pattern="#,##0.###"
                       isBlankWhenNull="true">

                <reportElement x="465"
                               y="0"
                               width="100"
                               height="18"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font fontName="맑은 고딕"
                          size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{qty}
                ]]></textFieldExpression>

            </textField>


            <!-- Pallet -->
            <textField pattern="#,##0.###"
                       isBlankWhenNull="true">

                <reportElement x="565"
                               y="0"
                               width="100"
                               height="18"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font fontName="맑은 고딕"
                          size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{pallet}
                ]]></textFieldExpression>

            </textField>


            <!-- LOT -->
            <textField isBlankWhenNull="true">

                <reportElement x="665"
                               y="0"
                               width="137"
                               height="18"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font fontName="맑은 고딕"
                          size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{lotNo}
                ]]></textFieldExpression>

            </textField>


            <!-- 세로선 -->

            <line>
                <reportElement x="0" y="0"
                               width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <line>
                <reportElement x="80" y="0"
                               width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <line>
                <reportElement x="465" y="0"
                               width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <line>
                <reportElement x="565" y="0"
                               width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <line>
                <reportElement x="665" y="0"
                               width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <line>
                <reportElement x="801" y="0"
                               width="1" height="18"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>


            <!-- 하단선 -->
            <line>
                <reportElement x="0"
                               y="17"
                               width="802"
                               height="1"/>

                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>


        </band>

    </detail>


</jasperReport>